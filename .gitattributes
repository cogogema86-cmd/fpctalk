# 저장소 안에서는 항상 LF로 보관 (맥/윈도우 CRLF 충돌 차단)
* text=auto eol=lf

# 플랫폼 전용 스크립트는 예외
*.sh   text eol=lf
*.bash text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 바이너리 (변환/diff 금지)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.xlsx binary
*.xls  binary
*.db   binary
*.sqlite  binary
*.sqlite3 binary
*.apk  binary
*.jar  binary

# 락파일은 diff 노이즈만 만드니 접어두기
package-lock.json -diff
pnpm-lock.yaml    -diff
yarn.lock         -diff
uv.lock           -diff
poetry.lock       -diff
pubspec.lock      -diff
